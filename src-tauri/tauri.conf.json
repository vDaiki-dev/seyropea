{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SeyroPea",
  "version": "0.2.0",
  "identifier": "dev.vdaiki.seyropea",
  "build": {
    "frontendDist": "../src/frontend"
  },
  "app": {
    "windows": [
      {
        "title": "SeyroPea — Estudio de edición",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "vDaiki-dev",
    "category": "GraphicsAndDesign",
    "shortDescription": "Editor de imágenes ligero, offline y sin IA",
    "longDescription": "SeyroPea es un estudio de edición de imágenes de escritorio: capas, filtros deterministas, temas personalizables, formato .seyro y funcionamiento 100% offline.",
    "copyright": "Copyright © 2026 vDaiki-dev",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "wix": {
        "language": "es-ES"
      }
    }
  }
}
